#!/bin/bash --login
#SBATCH --job-name=star_idx
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=01:30:00
#SBATCH --output=/mnt/scratch/lemasjoh/B.hybridum/logs/%x-%j.SLURMout

# Paths
BASE="/mnt/scratch/lemasjoh/B.hybridum"
GENOME="$BASE/01_inputs/B.hyb.genome.fa"
ANNO="$BASE/01_inputs/B.hyb.star.gtf"
INDEX="$BASE/01_inputs/B.hyb_indexed"

echo -e ">>>STAR:\n\tRunning build mode.\nInput fasta:\n\t${GENOME}\nInput annotation:\n\t${ANNO}"

echo -e "..making output directory:\n\t${INDEX}"
mkdir -p $INDEX

echo -e "...loading module.."
ml purge
ml load STAR/2.7.11b-GCC-13.2.0

STAR \
     --runMode genomeGenerate \
     --runThreadN $SLURM_CPUS_PER_TASK \
     --genomeDir $INDEX \
     --genomeFastaFiles $GENOME \
     --sjdbGTFfile $ANNO \
     --sjdbGTFfeatureExon exon \
     --sjdbOverhang 74 \
     --genomeSAindexNbases 13 \

echo -e "..process complete. Indexed genome is in\n\t${INDEX}"
